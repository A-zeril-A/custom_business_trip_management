<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Business Trip Management Category -->
    <record id="module_category_business_trip_management" model="ir.module.category">
        <field name="name">Business Trip Management</field>
        <field name="description">Business Trip Management System</field>
        <field name="sequence">10</field>
    </record>


    <record id="group_business_trip_manager" model="res.groups">
        <field name="name">Business Trip Administrator</field>
        <field name="category_id" ref="module_category_business_trip_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Users in this group can configure and administer all business trips in their allowed companies.</field>
    </record>  

    <record id="group_business_trip_approver" model="res.groups">
        <field name="name">Business Trip Approver</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Technical capability for users assigned as travel approvers on individual trips.</field>
    </record>

    <record id="group_business_trip_organizer" model="res.groups">
        <field name="name">Business Trip Organizer</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Technical role managed by the active organizer company setting.</field>
    </record>

    <record id="group_business_trip_expense_reviewer" model="res.groups">
        <field name="name">Business Trip Expense Reviewer</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Technical capability for configured business trip expense reviewers.</field>
    </record>

    <record id="group_business_trip_auditor" model="res.groups">
        <field name="name">Business Trip Auditor</field>
        <field name="category_id" ref="module_category_business_trip_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Users in this group can read all business trips in allowed companies without modifying them.</field>
    </record>
  
    
    <record id="group_business_trip_manager_sale_order" model="res.groups">
        <field name="name">Travel Approver (Sale Order)</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('custom_business_trip_management.group_business_trip_approver'))]"/>
        <field name="comment">Technical role managed by the fallback sale-order approver company setting.</field>
    </record>

    <record id="group_business_trip_manager_standalone" model="res.groups">
        <field name="name">Travel Approver (Standalone)</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('custom_business_trip_management.group_business_trip_approver'))]"/>
        <field name="comment">Technical role managed by the standalone approver company setting.</field>
    </record>

    <record id="group_business_trip_requester" model="res.groups">
        <field name="name">Business Trip Requester</field>
        <field name="category_id" ref="module_category_business_trip_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Users in this group can request business trips and view all sale orders for selection.</field>
    </record> 

    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('custom_business_trip_management.group_business_trip_requester'))]"/>
    </record>

    <!-- Business trip record security -->
    <record id="business_trip_requester_rule" model="ir.rule">
        <field name="name">Business Trip: requester owns record</field>
        <field name="model_id" ref="model_business_trip"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_business_trip_requester'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="business_trip_approver_rule" model="ir.rule">
        <field name="name">Business Trip: approver assigned record</field>
        <field name="model_id" ref="model_business_trip"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_business_trip_approver'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="business_trip_organizer_read_rule" model="ir.rule">
        <field name="name">Business Trip: active organizer company workspace</field>
        <field name="model_id" ref="model_business_trip"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('company_id.business_trip_organizer_ids', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('group_business_trip_organizer'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="business_trip_organizer_write_rule" model="ir.rule">
