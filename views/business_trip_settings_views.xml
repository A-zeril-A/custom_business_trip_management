<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Settings form view -->
    <record id="res_config_settings_view_form_business_trip" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.business.trip</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Business Trips"
                     string="Business Trips"
                     name="custom_business_trip_management"
                     groups="base.group_system,custom_business_trip_management.group_business_trip_manager">
                    <block title="Approval Process" id="business_trip_approval_process">
                        <setting id="business_trip_sale_order_travel_approver"
                                 string="Travel Approver (Sale Order)"
                                 company_dependent="1"
                                 help="If set, sale-order travel requests go to this user. Leave empty to use each employee's direct manager.">
                            <field name="travel_approver_sale_order_user_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </setting>
                        <setting id="business_trip_standalone_travel_approver"
                                 string="Travel Approver (Standalone)"
                                 company_dependent="1"
                                 help="Select the default Travel Approver for standalone trips.">
                            <field name="travel_approver_standalone_user_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </setting>
                        <setting id="business_trip_active_organizer"
                                 string="Business Trip Organizers"
                                 company_dependent="1"
                                 help="Users the Travel Approver can pick as trip organizer. Removing a user with open trips hands them over to the single remaining organizer, or requires reassigning those trips first.">
                            <field name="business_trip_organizer_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </setting>
                        <setting id="business_trip_sale_order_expense_reviewer"
                                 string="Expense Reviewer (Sale Order)"
                                 company_dependent="1"
                                 help="Select the reviewer responsible for sale-order trip expenses.">
                            <field name="business_trip_sale_order_expense_reviewer_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </setting>
                        <setting id="business_trip_standalone_expense_reviewer"
                                 string="Expense Reviewer (Standalone)"
                                 company_dependent="1"
                                 help="Select the reviewer responsible for standalone trip expenses.">
                            <field name="business_trip_standalone_expense_reviewer_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </setting>
                        <setting id="business_trip_undo_expense_approval_deadline"
                                 string="Expense Approval Reopen Window"
                                 company_dependent="1"
                                 help="Controls how long an approved expense can be reopened and sent back to expense review by an authorized user. Set 0 for no limit.">
                            <div class="content-group">
                                <span class="oe_inline">Allow reopening for</span>
                                <field name="undo_expense_approval_days_limit" class="oe_inline" widget="integer"/>
                                <span class="oe_inline">days after approval</span>
                            </div>
                        </setting>
                    </block>
                    <block title="Employee Expense Follow-up" id="business_trip_employee_expense_submission_reminders">
                        <setting id="business_trip_employee_expense_reminder_delay"
                                 string="Employee First Reminder"
                                 company_dependent="1"
                                 help="Controls when the employee first receives a grouped expense reminder email and a To Do activity after the trip ends.">
                            <div class="content-group">
                                <span class="oe_inline">Send the first employee reminder</span>
                                <field name="employee_expense_reminder_delay" class="oe_inline" widget="integer"/>
                                <field name="employee_expense_reminder_delay_type" class="oe_inline"/>
                                <span class="oe_inline">after the trip ends</span>
                            </div>
                        </setting>
                        <setting id="business_trip_employee_expense_digest_send_hour"
                                 string="Employee Reminder Time"
                                 company_dependent="1"
                                 help="Controls the hour of day when employee reminder emails and To Do items are created.">
                            <div class="content-group">
                                <span class="oe_inline">Deliver employee reminders at</span>
                                <field name="employee_expense_digest_send_hour" class="oe_inline" widget="integer"/>
                                <span class="oe_inline">:00 server time</span>
                            </div>
                        </setting>
                        <setting id="business_trip_expense_reminder_interval"
                                 string="Employee Reminder Repeat"
                                 company_dependent="1"
                                 help="Controls how often grouped employee reminders repeat while the expense is still unresolved.">
                            <div class="content-group">
                                <span class="oe_inline">Repeat employee reminders every</span>
                                <field name="expense_reminder_interval" class="oe_inline" widget="integer"/>
                                <field name="expense_reminder_interval_type" class="oe_inline"/>
                            </div>
                        </setting>
                    </block>
                    <block title="Expense Reviewer Follow-up" id="business_trip_organizer_expense_submission_reminders">
                        <setting id="business_trip_organizer_expense_escalation_delay"
                                 string="Expense Reviewer Follow-up Starts"
                                 company_dependent="1"
                                 help="Controls when the configured expense reviewer starts receiving grouped reminders if the employee still has not clarified the trip expenses after the trip ends.">
                            <div class="content-group">
                                <span class="oe_inline">Start notifying the expense reviewer</span>
                                <field name="organizer_expense_escalation_delay" class="oe_inline" widget="integer"/>
                                <field name="organizer_expense_escalation_delay_type" class="oe_inline"/>
                                <span class="oe_inline">after the trip ends</span>
                            </div>
                        </setting>
                        <setting id="business_trip_organizer_expense_digest_send_hour"
                                 string="Expense Reviewer Reminder Time"
                                 company_dependent="1"
                                 help="Controls the hour of day when expense reviewer follow-up reminders are created.">
                            <div class="content-group">
                                <span class="oe_inline">Deliver expense reviewer reminders at</span>
                                <field name="organizer_expense_digest_send_hour" class="oe_inline" widget="integer"/>
                                <span class="oe_inline">:00 server time</span>
                            </div>
                        </setting>
                        <setting id="business_trip_organizer_expense_reminder_interval"
                                 string="Expense Reviewer Reminder Repeat"
                                 company_dependent="1"
                                 help="Controls how often grouped expense reviewer reminders repeat while the expense is still unresolved.">
                            <div class="content-group">
                                <span class="oe_inline">Repeat expense reviewer reminders every</span>
                                <field name="organizer_expense_reminder_interval" class="oe_inline" widget="integer"/>
                                <field name="organizer_expense_reminder_interval_type" class="oe_inline"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Settings action -->
    <record id="action_business_trip_settings" model="ir.actions.act_window">
        <field name="name">Business Trip Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'custom_business_trip_management', 'bin_size': False}</field>
    </record>

    <!-- Settings menu -->
    <menuitem id="menu_business_trip_settings"
        name="Settings"
        parent="custom_business_trip_management.menu_business_trip_root"
        action="action_business_trip_settings"
        sequence="100"
        groups="base.group_system,custom_business_trip_management.group_business_trip_manager"/>


</odoo> 